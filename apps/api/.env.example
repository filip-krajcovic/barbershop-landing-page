# Skopíruj do apps/api/.env a uprav podľa potreby.
NODE_ENV=development
PORT=3001

# Origin webu (CORS + better-auth trustedOrigins)
WEB_URL=http://localhost:3000

# PostgreSQL (zodpovedá docker-compose.yml)
DATABASE_URL=postgres://britva:britva@localhost:5432/britva

# better-auth: tajný kľúč aspoň 32 znakov (napr. `openssl rand -base64 32`)
BETTER_AUTH_SECRET=change-me-to-a-random-string-of-32-chars
# Verejná URL webu: prehliadač volá /api/auth/* cez web (Nuxt proxy), nie priamo API
BETTER_AUTH_URL=http://localhost:3000

# Tajný kľúč zdieľaný s webom (NUXT_API_PROXY_SECRET), aspoň 32 znakov. Ak je nastavený,
# API prijme iba requesty z webu – nastav ho, keď je API verejne dostupné (napr. cez tunel).
PROXY_SECRET=

# Max. počet rezervácií z jednej IP adresy za minútu
BOOKING_RATE_LIMIT=10
