# Skopíruj do apps/web/.env a uprav podľa potreby.
# URL API bez /api – server webu naň preposiela /api/** (prehliadač volá iba web)
NUXT_API_PROXY_URL=http://localhost:3001
# Tajný kľúč, ktorým sa web preukazuje API – rovnaký ako PROXY_SECRET v apps/api/.env
# (lokálne môže ostať prázdny)
NUXT_API_PROXY_SECRET=
# Verejná URL webu (kanonické odkazy, Open Graph)
NUXT_PUBLIC_SITE_URL=http://localhost:3000
